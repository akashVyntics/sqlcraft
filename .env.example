# This is a names-only example. Never commit real credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.example
CSRF_TRUSTED_ORIGINS=https://your-app.example
# Required in production: PostgreSQL connection URL. SQLite is local-development only.
DATABASE_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SQLCraft <noreply@your-app.example>
# Optional Google OAuth. Both values are needed to show the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only true behind a trusted reverse proxy that strips incoming forwarded headers.
TRUST_PROXY_HTTPS=false
# Production execution service: private network URL and a random shared token.
SQL_RUNNER_URL=http://runner:9000
SQL_RUNNER_TOKEN=
